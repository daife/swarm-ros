      <collision name="collision">
        <geometry>
          <box>
            <size>1.20 1.20 1.60</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>1.20 1.20 1.60</size>
          </box>
        </geometry>
        <material>
          <ambient>0.40 0.62 0.82 1.0</ambient>
          <diffuse>0.40 0.62 0.82 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>

<?xml version="1.0"?>
<sdf version="1.9">
  <world name="urban">
    <gravity>0 0 -9.8</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>1.0 1.0 1.0 1.0</ambient>
      <background>0.72 0.72 0.72 1.0</background>
      <shadows>false</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boundary_north">
      <static>true</static>
      <pose>0 10.1 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.2 0.2 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.2 0.2 2.2</size></box></geometry>
          <material><ambient>0.38 0.38 0.44 0.35</ambient><diffuse>0.38 0.38 0.44 0.35</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="boundary_south">
      <static>true</static>
      <pose>0 -10.1 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20.2 0.2 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.2 0.2 2.2</size></box></geometry>
          <material><ambient>0.38 0.38 0.44 0.35</ambient><diffuse>0.38 0.38 0.44 0.35</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="boundary_east">
      <static>true</static>
      <pose>10.1 0 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 20.2 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 20.2 2.2</size></box></geometry>
          <material><ambient>0.38 0.38 0.44 0.35</ambient><diffuse>0.38 0.38 0.44 0.35</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="boundary_west">
      <static>true</static>
      <pose>-10.1 0 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 20.2 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 20.2 2.2</size></box></geometry>
          <material><ambient>0.38 0.38 0.44 0.35</ambient><diffuse>0.38 0.38 0.44 0.35</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
